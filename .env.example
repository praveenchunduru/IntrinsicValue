# Settings for IntrinsicValue. Copy this file to `.env` in the same folder and fill in
# the two values. The program reads `.env` when it starts and never writes to it.
# A value exported in your shell takes priority over this file.

# Your OpenRouter API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Your email. The SEC asks automated requests to identify a contact; it is sent only to sec.gov.
SEC_CONTACT_EMAIL=
